{
  "name": "travel-footprint",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run clean && vite build && esbuild src/server/start.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server/index.mjs",
    "start": "node dist/server/index.mjs",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/server.test.ts tests/sqliteStore.test.ts tests/placeOverview.test.tsx tests/browserLocation.test.ts tests/mediaLocation.test.ts tests/photoUploadLocation.test.ts tests/photoMetadata.test.ts tests/mapClusters.test.ts tests/mapViewport.test.ts tests/geocoding.test.ts",
    "test:production": "node scripts/verify-production.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:import": "tsx scripts/import-json-to-sqlite.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.2.3",
    "exifr": "^7.1.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "argon2@0.44.0": true
  }
}
