# Local server settings. Copy this file to .env when overrides are needed.
NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000

# Required by `npm start`. Generate a unique random value of at least 32 characters.
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
# APP_ORIGIN=http://127.0.0.1:3000

# Reserved for the later AMap phase.
AMAP_WEB_KEY=
AMAP_WEB_SERVICE_KEY=
AMAP_SECURITY_JSCODE=
