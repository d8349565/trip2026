# Local server settings. Copy this file to .env when overrides are needed.
NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000
# 开发环境通过临时反向代理访问时，按逗号分隔填写允许的 Host。
# 例如：VITE_ALLOWED_HOSTS=example.trycloudflare.com
VITE_ALLOWED_HOSTS=
# APP_UPLOADS_DIR=uploads

# Required by `npm start`. Generate a unique random value of at least 32 characters.
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
# APP_ORIGIN=http://127.0.0.1:3000
# 公网 HTTPS 部署必须改为实际访问来源，例如：
# APP_ORIGIN=https://travel.example.com
# SESSION_COOKIE_SECURE=true

# 手机通过局域网访问并使用浏览器定位时必须启用“手机信任”的 HTTPS。
# 证书必须包含访问用的域名或局域网 IP；仅生成但未在手机上信任的自签证书仍不可用。
# APP_TLS_CERT=local-tls/travel-footprint.pem
# APP_TLS_KEY=local-tls/travel-footprint-key.pem
# APP_ORIGIN=https://travel-footprint.home:3000
# SESSION_COOKIE_SECURE=true

# Reserved for the later AMap phase.
AMAP_WEB_KEY=
AMAP_WEB_SERVICE_KEY=
AMAP_SECURITY_JSCODE=
